include($KDE_DOCS/global/qt-module-defaults.qdocconf)

project = AkonadiContactWidgets
moduleheader = akonadicontactwidgets_qdocmoduleheader.h
description = AkonadiContactWidgets provides API to akonadi contacts widgets.


documentationinheaders = true

headerdirs += .
sourcedirs += .

excludedirs += \
    editor/addresseditor/autotests \
    editor/customfieldeditor/autotests \
    editor/customfieldeditor/tests \
    editor/generalinfoeditor/autotests \
    editor/generalinfoeditor/tests \
    editor/widgets/autotests \
    tests

outputformats = HTML

depends += \
    qtcore

navigation.landingpage = "AkonadiContactWidgets"

qhp.projects            = akonadicontactwidgets

qhp.akonadicontactwidgets.file                = akonadicontactwidgets.qhp
qhp.akonadicontactwidgets.namespace           = org.kde.akonadicontactwidgets.$QT_VERSION_TAG
qhp.akonadicontactwidgets.virtualFolder       = akonadicontactwidgets
qhp.akonadicontactwidgets.indexTitle          = AkonadiContactWidgets
qhp.akonadicontactwidgets.indexRoot           =

qhp.akonadicontactwidgets.subprojects         = classes
qhp.akonadicontactwidgets.subprojects.classes.title = C++ Classes
qhp.akonadicontactwidgets.subprojects.classes.indexTitle = AkonadiContact Widgets C++ Classes
qhp.akonadicontactwidgets.subprojects.classes.selectors = class fake:headerfile
qhp.akonadicontactwidgets.subprojects.classes.sortPages = true

tagfile = akonadicontactwidgets.tags
